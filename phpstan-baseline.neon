parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method boot\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/App.php

		-
			message: '#^Cannot call method load\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/App.php

		-
			message: '#^Method Quillstack\\Framework\\App\:\:__construct\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App.php

		-
			message: '#^Method Quillstack\\Framework\\App\:\:__construct\(\) has parameter \$middleware with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App.php

		-
			message: '#^Method Quillstack\\Framework\\App\:\:getConfigWithEnvPath\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App.php

		-
			message: '#^Method Quillstack\\Framework\\App\:\:getConfigWithEnvPath\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App.php

		-
			message: '#^Method Quillstack\\Framework\\App\:\:loadEnvIfRequired\(\) has parameter \$configWithEnv with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App.php

		-
			message: '#^Constant Quillstack\\Framework\\App\\Config\:\:DEFAULT_MIDDLEWARE type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Config.php

		-
			message: '#^Method Quillstack\\Framework\\App\\Config\:\:get\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Config.php

		-
			message: '#^Method Quillstack\\Framework\\App\\Config\:\:get\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Config.php

		-
			message: '#^Property Quillstack\\Framework\\App\\Config\:\:\$defaultConfig type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Config.php

		-
			message: '#^Cannot call method setRoutes\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Method Quillstack\\Framework\\App\\Kernel\:\:boot\(\) has parameter \$middleware with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Method Quillstack\\Framework\\App\\Kernel\:\:loadHeaders\(\) has parameter \$headers with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Method Quillstack\\Framework\\App\\Kernel\:\:loadMiddleware\(\) has parameter \$middleware with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Parameter \#1 \$fallbackHandler of method Quillstack\\Middleware\\MiddlewareBuilder\:\:build\(\) expects Psr\\Http\\Server\\RequestHandlerInterface, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Property Quillstack\\Framework\\App\\Kernel\:\:\$dispatcher is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/App/Kernel.php

		-
			message: '#^Cannot call method error\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Http/Middleware/ErrorMiddleware.php

		-
			message: '#^Method Quillstack\\Framework\\Http\\Responses\\ErrorResponse\:\:send\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Http/Responses/ErrorResponse.php

		-
			message: '#^Property Quillstack\\Framework\\Http\\Responses\\ErrorResponse\:\:\$details type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Http/Responses/ErrorResponse.php

		-
			message: '#^Method Quillstack\\Framework\\Http\\Responses\\NotFoundResponse\:\:send\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Http/Responses/NotFoundResponse.php

		-
			message: '#^Cannot call method createGivenServerRequest\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/InstanceFactories/RequestClassFactory.php

		-
			message: '#^Method Quillstack\\Framework\\Providers\\ConfigProvider\:\:load\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Providers/ConfigProvider.php

		-
			message: '#^Property Quillstack\\Framework\\Providers\\ConfigProvider\:\:\$config type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Providers/ConfigProvider.php

		-
			message: '#^Method Quillstack\\Framework\\Services\\AppEnvService\:\:env\(\) should return string but returns bool\|float\|int\|string\.$#'
			identifier: return.type
			count: 1
			path: src/Services/AppEnvService.php

		-
			message: '#^Method Quillstack\\Framework\\Services\\AppEnvService\:\:isEnv\(\) has parameter \$env with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Services/AppEnvService.php
